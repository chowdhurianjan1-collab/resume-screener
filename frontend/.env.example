# Copy to .env and adjust as needed.
VITE_API_URL=http://localhost:8000

# PRODUCTION (e.g. Vercel): set VITE_API_URL in your hosting dashboard's
# Environment Variables settings — Vite bakes this in at BUILD time, so a
# .env file alone won't affect an already-deployed site. Redeploy after
# changing it. Example:
# VITE_API_URL=https://resume-screener-backend-90iw.onrender.com
