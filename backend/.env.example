# Copy to .env and adjust as needed.

# Defaults to a local SQLite file if unset.
DATABASE_URL=sqlite:///./resume_screener.db

# Comma-separated list of origins allowed to call this API.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# PRODUCTION (e.g. Render): set this in your hosting dashboard's Environment
# tab to include your real frontend URL. Any *.vercel.app origin is already
# allowed automatically by main.py as a fallback, but set this explicitly too:
# ALLOWED_ORIGINS=https://resume-screener-frontend-pied.vercel.app
